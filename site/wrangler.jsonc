{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redbluebutton",
  "compatibility_date": "2026-11-16",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "pressredorblue.com", "custom_domain": true },
    { "pattern": "www.pressredorblue.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "."
  }
}
